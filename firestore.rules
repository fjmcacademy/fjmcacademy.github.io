rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // ADMIN
    // =====================================================
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "fjmcacademy1008@gmail.com";
    }

    // =====================================================
    // STUDENTS
    // Student can read/update only his/her own profile.
    // Admin has full access.
    // =====================================================
    match /students/{userId} {
      allow read: if isAdmin()
                  || (
                    request.auth != null
                    && resource.data.email == request.auth.token.email
                  );

      allow create, update: if isAdmin()
                           || (
                             request.auth != null
                             && request.resource.data.email == request.auth.token.email
                           );

      allow delete: if isAdmin();
    }

    // =====================================================
    // COURSES
    // Dashboard needs to read assigned course documents.
    // Only admin can create/edit/delete courses.
    // =====================================================
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // LECTURE-WISE TESTS
    // Students read tests; admin manages questions/tests.
    // =====================================================
    match /tests/{testId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // TEST RESULTS
    // First attempt is stored at a fixed result document ID.
    // Students can read leaderboard data and create only their
    // own result. They cannot edit/delete results.
    // Admin has full access.
    // =====================================================
    match /testResults/{resultId} {
      allow read: if request.auth != null;

      allow create: if isAdmin()
                    || (
                      request.auth != null
                      && request.resource.data.uid == request.auth.uid
                    );

      allow update, delete: if isAdmin();
    }

    // =====================================================
    // DEVICE SYSTEM
    // IMPORTANT: dashboard.js device logic is NOT changed.
    // Student can access only own users/{uid} data/devices.
    // Admin can view/release any device reservation.
    // =====================================================
    match /users/{userId} {
      allow read, write: if isAdmin()
                         || (request.auth != null && request.auth.uid == userId);

      match /devices/{deviceId} {
        allow read, write: if isAdmin()
                           || (request.auth != null && request.auth.uid == userId);
      }
    }

    // =====================================================
    // DENY EVERYTHING ELSE
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
